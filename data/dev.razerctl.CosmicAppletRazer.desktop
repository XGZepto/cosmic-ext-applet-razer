[Desktop Entry]
Name=Razer Control
Comment=Performance, fans, keyboard lighting and battery limit for Razer laptops
Type=Application
Exec=cosmic-ext-applet-razer
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Razer;Fan;Keyboard;RGB;Battery;
Icon=dev.razerctl.CosmicAppletRazer-symbolic
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=10
